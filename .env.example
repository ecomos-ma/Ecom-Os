# ─── Supabase (public) ───
VITE_APP_URL=https://www.ecomos.ma
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# ─── WhatsApp Worker (local development - server-side only) ───
# This secret is used by Vite dev server to authenticate with the local worker
# DO NOT prefix with VITE_ - this must remain server-side only
# Set this to the same value as WORKER_API_SECRET in whatsapp-worker/.env
WHATSAPP_WORKER_API_SECRET=your_worker_api_secret
WHATSAPP_WORKER_DEV_URL=http://127.0.0.1:5000
WHATSAPP_WORKER_URL=https://whatsapp-worker.your-domain.example

# ─── Browser OAuth callback URLs (public, optional) ───
VITE_YOUCAN_REDIRECT_URI=https://www.ecomos.ma/api/youcan/callback

# ─── Private Variables (Backend Only - NEVER expose to frontend) ───
SUPABASE_SERVICE_ROLE_KEY=your_secure_backend_service_role_key

# ─── Notification Edge Functions (backend secrets; never prefix with VITE_) ───
VAPID_PUBLIC_KEY=your_url_safe_vapid_public_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:operations@example.com
NOTIFICATION_WORKER_SECRET=generate_a_long_random_secret
ALLOWED_FRONTEND_ORIGINS=https://www.ecomos.ma,https://ecomos.ma,http://localhost:8080,http://127.0.0.1:8080

# ─── URL configurations ───
FRONTEND_URL=https://your-domain.example
