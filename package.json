{
  "name": "ecomos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:run",
    "test:run": "npm run test:i18n && npm run test:notifications && npm run test:tiktok && npm run test:whatsapp && npm run test:workspace-reset && npm run test:multitenant",
    "test:i18n": "node --experimental-strip-types --test tests/i18n-*.test.ts",
    "test:notifications": "node --experimental-strip-types --test tests/notification-*.test.ts",
    "test:tiktok": "node --experimental-strip-types --test tests/tiktok-*.test.ts",
    "test:whatsapp": "node --experimental-strip-types --test tests/whatsapp-*.test.ts",
    "test:workspace-reset": "node --experimental-strip-types --test tests/workspace-reset-contract.test.ts",
    "test:multitenant": "node --experimental-strip-types --test tests/multitenant-store-subscription-contract.test.ts",
    "preview": "vite preview",
    "verify": "npm run test:run && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-virtual": "^3.14.9",
    "dotenv": "^17.4.2",
    "framer-motion": "^10.12.5",
    "http-proxy-middleware": "^4.2.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "lucide-react": "^1.23.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "7.18.2",
    "recharts": "^3.10.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.0",
    "autoprefixer": "10.5.4",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "postcss": "8.5.26",
    "sharp": "^0.35.3",
    "supabase": "^2.115.0",
    "tailwindcss": "3.4.19",
    "typescript": "^5.5.4",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
